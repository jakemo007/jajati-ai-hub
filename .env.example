# Copy to .env for local testing, or set these in Cloudflare Pages > Settings > Environment variables.
# Every value is optional. With none set, the site builds and runs with analytics switched off (no-op).

# Production URL, used for canonical links, Open Graph URLs and the sitemap. No trailing slash.
# Default when empty: https://jajati-ai-hub.pages.dev
SITE_URL=

# Google Analytics 4 Measurement ID, format G-XXXXXXXXXX. Leave empty to keep GA4 off.
PUBLIC_GA4_ID=

# Cloudflare Web Analytics token for the manual JS snippet. Leave empty if you enable
# Web Analytics with the one-click setting in the Pages project (Metrics > Web Analytics),
# otherwise page views are counted twice.
PUBLIC_CF_ANALYTICS_TOKEN=
