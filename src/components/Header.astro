---
import Menu from '@lucide/astro/icons/menu';
import BrandMark from './BrandMark.astro';
import { NAV, SITE } from '../data/site';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur" data-section="header">
  <div class="container-ja flex h-16 items-center justify-between gap-3">
    <a href="/" class="flex min-w-0 items-center gap-2.5 text-text no-underline" aria-label={`${SITE.name}, home`}>
      <BrandMark size={34} />
      <span class="truncate text-lg font-bold tracking-tight">Jajati <span class="text-cyan">AI</span></span>
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-lg px-3 py-2 text-[0.95rem] font-medium no-underline hover:text-cyan-soft',
                  isActive(item.href) ? 'text-cyan-soft' : 'text-text',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/start/" class="btn btn-primary btn-small hidden sm:inline-flex">Start here</a>
      <button
        type="button"
        class="btn btn-secondary btn-small md:hidden"
        data-menu-toggle
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <Menu size={20} aria-hidden="true" />
        <span>Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Main" class="border-t border-line md:hidden" hidden>
    <ul class="container-ja grid gap-1 py-3">
      <li>
        <a href="/start/" class="block rounded-lg px-3 py-3 font-semibold text-cyan-soft no-underline">Start here</a>
      </li>
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-3 font-medium text-text no-underline hover:bg-surface"
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
