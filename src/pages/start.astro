---
/**
 * /start/ is the Instagram and YouTube bio link. Keep it short and phone-first:
 * keyword → sheet first, then popular prompts, the latest episode and the two channels.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CirclePlay from '@lucide/astro/icons/circle-play';
import Camera from '@lucide/astro/icons/camera';
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import VideoLinks from '../components/VideoLinks.astro';
import { SOCIAL } from '../data/site';
import { getEpisodes, getPrompts, getPublishedEpisodes, getResources } from '../utils/content';
import { paths } from '../utils/urls';

const resources = await getResources();
const prompts = (await getPrompts()).filter((p) => p.data.featured).slice(0, 6);
const episodes = await getPublishedEpisodes();
const latest = episodes[episodes.length - 1];
const nextUp = (await getEpisodes()).find((e) => e.data.status === 'coming-soon');
const formatsOf = (r: (typeof resources)[number]) => [...new Set(r.data.files.map((f) => f.format))].join(' + ');
---

<BaseLayout
  title="Start Here: Free AI Prompts and Cheat Sheets"
  description="Came from a reel? Pick your keyword (PROMPT, SACH or RAG) and get the free cheat sheet, plus popular prompts and the latest AI Explained episode."
  pageType="start"
>
  <div class="container-ja max-w-2xl pt-6 md:pt-10">
    <h1 class="text-3xl font-extrabold md:text-4xl">Free AI prompts &amp; cheat sheets</h1>
    <p class="mt-2 text-lg text-muted">Reel se aaye? Apna keyword chuno. Free hai, DM ki zaroorat nahi.</p>

    <section class="mt-6" aria-labelledby="sheets-title" data-section="start_sheets">
      <h2 id="sheets-title" class="sr-only">Cheat sheets by keyword</h2>
      <ul class="grid gap-3">
        {
          resources.map((r, i) => (
            <li>
              <a
                href={paths.resource(r.id)}
                class:list={[
                  'card card-link flex items-center gap-4 p-4 no-underline',
                  i === 0 && 'border-cyan/60 bg-cyan/5',
                ]}
              >
                <span class="min-w-[5.5rem] rounded-lg bg-raised px-2 py-2 text-center text-lg font-extrabold tracking-wide text-cyan-soft">
                  {r.data.keyword}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-bold text-text">{r.data.shortTitle}</span>
                  <span class="block text-sm text-muted">{`${formatsOf(r)}, free download`}</span>
                </span>
                <ArrowRight size={20} class="shrink-0 text-muted" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="popular-title" data-section="start_prompts">
      <h2 id="popular-title" class="text-xl font-bold">Popular prompts</h2>
      <ul class="mt-3 grid gap-2">
        {
          prompts.map((p) => (
            <li>
              <a
                href={paths.prompt(p.id)}
                class="flex items-center justify-between gap-3 rounded-xl border border-line px-4 py-3 text-text no-underline hover:border-cyan/60"
              >
                <span>{p.data.title}</span>
                <ArrowRight size={18} class="shrink-0 text-muted" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/prompts/" class="btn btn-secondary btn-small mt-3">Browse all prompts</a>
    </section>

    {
      latest && (
        <section class="mt-10" aria-labelledby="latest-title" data-section="start_episode">
          <h2 id="latest-title" class="text-xl font-bold">
            Latest AI Explained episode
          </h2>
          <div class="mt-3">
            <EpisodeCard episode={latest} />
          </div>
          <div class="mt-3">
            <VideoLinks
              youtube={latest.data.videos.youtube}
              instagram={latest.data.videos.instagram}
              track={{ episode_id: latest.id, episode_title: latest.data.title }}
              location="start_page"
            />
          </div>
          <p class="mt-3 text-sm text-muted">
            {nextUp && (
              <>
                Next episode: <strong class="text-text">{nextUp.data.title}</strong> (coming soon).{' '}
              </>
            )}
            <a href="/episodes/">All episodes</a>
          </p>
        </section>
      )
    }

    <section class="mt-10" aria-labelledby="follow-title" data-section="start_follow">
      <h2 id="follow-title" class="text-xl font-bold">Follow for the next episode</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <a
          href={SOCIAL.instagram.url}
          rel="noopener"
          class="btn btn-secondary justify-start"
          data-track="instagram_click"
          data-track-params={JSON.stringify({ link_location: 'start_page' })}
        >
          <Camera size={20} aria-hidden="true" />
          Instagram {SOCIAL.instagram.handle}
        </a>
        <a
          href={SOCIAL.youtube.url}
          rel="noopener"
          class="btn btn-secondary justify-start"
          data-track="youtube_click"
          data-track-params={JSON.stringify({ link_location: 'start_page' })}
        >
          <CirclePlay size={20} aria-hidden="true" />
          YouTube {SOCIAL.youtube.handle}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
