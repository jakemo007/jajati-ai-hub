---
import Search from '@lucide/astro/icons/search';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import LearningPath from '../../components/LearningPath.astro';
import { getEpisodes } from '../../utils/content';
import { absolute, paths } from '../../utils/urls';

const episodes = await getEpisodes();
const published = episodes.filter((e) => e.data.status === 'published');
const coming = episodes.filter((e) => e.data.status === 'coming-soon');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'AI Explained episodes',
    url: absolute('/episodes/', Astro.site),
    hasPart: published.map((e) => ({
      '@type': 'LearningResource',
      name: e.data.headline,
      url: absolute(paths.episode(e.id), Astro.site),
    })),
  },
];
---

<BaseLayout
  title="AI Explained in Hindi: All Episodes"
  description="The AI Explained series in simple Hindi: tokens, context window, hallucination, RAG and prompt engineering. Read each lesson, watch the video, test yourself."
  breadcrumbs={[{ label: 'Episodes' }]}
  jsonLd={jsonLd}
  pageType="episode_index"
>
  <section class="container-ja pt-6 md:pt-10">
    <p class="eyebrow">AI Explained series</p>
    <h1 class="mt-2 text-3xl font-extrabold md:text-5xl">AI Explained, in simple Hindi</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">
      One AI concept per episode, with something you can try today. Each lesson has the full explanation, the video
      links, sources and a quick quiz.
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div>
        <form class="relative" data-episode-search hidden role="search" aria-label="Search episodes">
          <label for="episode-search" class="sr-only">Search episodes</label>
          <Search size={20} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true" />
          <input
            id="episode-search"
            type="search"
            class="field pl-10"
            placeholder="Search: RAG, tokens, hallucination…"
            autocomplete="off"
          />
        </form>
        <p id="episode-count" class="mt-2 text-sm text-muted" aria-live="polite"></p>

        <section class="mt-4" aria-labelledby="published-title" data-episode-section>
          <h2 id="published-title" class="text-2xl font-bold">Published</h2>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {
              published.map((e) => (
                <li>
                  <EpisodeCard episode={e} />
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-12" aria-labelledby="coming-title" data-episode-section>
          <h2 id="coming-title" class="text-2xl font-bold">Coming soon</h2>
          <p class="mt-1 text-muted">Planned topics. No article or video yet.</p>
          <ul class="mt-4 grid gap-4 sm:grid-cols-2">
            {
              coming.map((e) => (
                <li>
                  <EpisodeCard episode={e} />
                </li>
              ))
            }
          </ul>
        </section>
        <p id="episode-empty" class="mt-6 rounded-xl border border-line p-6 text-center text-muted" hidden>
          No episode matches that search.
        </p>
      </div>

      <div class="lg:sticky lg:top-24">
        <LearningPath episodes={episodes} />
      </div>
    </div>
  </section>

  <script>
    import '../../scripts/episode-filter.ts';
  </script>
</BaseLayout>
