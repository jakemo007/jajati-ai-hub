{
  "name": "jajati-ai-hub",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Jajati AI | AI Explained Hindi: free prompts, cheat sheets and AI Explained lessons. Static Astro site for Cloudflare Pages.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "check:dist": "node tests/check-dist.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test": "npm run check && npm run build && npm run check:dist && npm run test:smoke",
    "og": "node tools/make-og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@lucide/astro": "1.70.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "5.18.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "@astrojs/language-server": "2.16.16",
    "sharp": "0.35.5",
    "astro": {
      "esbuild": "0.28.2"
    }
  }
}
